# Local environment template.
# Copy to `.env.local` and fill in the values as needed.
# Never commit real secrets or `.env.local`.

# Resend credentials — required for real contact form email delivery.
# Optional for local development when CONTACT_FORM_MOCK=true.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# Public site URL used for canonical URLs and sitemap.
# Optional — falls back to VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL,
# then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Mock mode for the contact form. Local and tests only (non-production).
# Must not be used as a substitute for real Resend configuration in production.
CONTACT_FORM_MOCK=false
